FROM debian:bookworm-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY oxidize-c oxidize-c
WORKDIR /src/oxidize-c
RUN make -j"$(nproc)" build

FROM debian:bookworm-slim
RUN useradd --create-home --shell /usr/sbin/nologin oxidize
COPY --from=builder /src/oxidize-c/oxidize-c /usr/local/bin/oxidize-c
USER oxidize
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/oxidize-c", "serve", "--host", "0.0.0.0", "--port", "8080"]
