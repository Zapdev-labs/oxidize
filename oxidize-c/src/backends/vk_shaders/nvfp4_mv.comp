#version 460
/* NVFP4 x int8 matvec for up to NV columns (decode / small verify). Eight
 * lanes share a row and split its K blocks; a workgroup covers 32 rows and
 * stages the columns' activations in shared memory, KMAX values of K at a
 * time; KMAX shrinks with NV so that several workgroups share a CU. KMAX is
 * a multiple of 512, so lane l always takes the blocks b = l (mod 8) in
 * increasing order and a column's result does not depend on NV. Same push block and post-ops as nvfp4_mm; with SITU a workgroup
 * covers 32 gate rows and the matching up rows. */
#include "common.glsl"
#extension GL_KHR_shader_subgroup_clustered : require
layout(constant_id = 0) const uint NV = 1u;
layout(constant_id = 1) const uint SITU = 0u;
const uint KMAX = NV > 2u ? 2048u : 4096u;
const uint KB = KMAX / 64u;
layout(local_size_x = 256) in;
MM_PUSH

shared uvec4 Aq[NV * KMAX / 16u];
shared float Ad[NV * KB];

/* lb: the block's index within the staged chunk */
void block_dot(uvec4 q0, uvec4 q1, uint sw, uint lb, uint count, inout float acc[NV])
{
    const vec4 ws = ue4m3h4(sw);
    const uvec4 w0 = e2m1_sub(q0.x, q0.y), w1 = e2m1_sub(q0.z, q0.w);
    const uvec4 w2 = e2m1_sub(q1.x, q1.y), w3 = e2m1_sub(q1.z, q1.w);
    [[unroll]] for (uint c = 0; c < NV; c++) {
        if (c < count) {
            const uint a = (c * KB + lb) * 4u;
            const float bs = float(dot16(w0, Aq[a])) * ws.x + float(dot16(w1, Aq[a + 1u])) * ws.y +
                             float(dot16(w2, Aq[a + 2u])) * ws.z + float(dot16(w3, Aq[a + 3u])) * ws.w;
            acc[c] += bs * Ad[c * KB + lb];
        }
    }
}

/* Blocks [b0, b1) of a row, two per step, both loads issued before either
 * is used. */
void row_dot(UV4 WQ, U32 WS, uint row, uint nb, uint b0, uint b1, uint lane, uint count, inout float acc[NV])
{
    uint b = b0 + lane;
    for (; b + 8u < b1; b += 16u) {
        const uint bi = row * nb + b, bj = bi + 8u;
        const uvec4 q0 = WQ.v[bi * 2u], q1 = WQ.v[bi * 2u + 1u], r0 = WQ.v[bj * 2u], r1 = WQ.v[bj * 2u + 1u];
        const uint si = WS.v[bi], sj = WS.v[bj];
        block_dot(q0, q1, si, b - b0, count, acc);
        block_dot(r0, r1, sj, b + 8u - b0, count, acc);
    }
    if (b < b1) {
        const uint bi = row * nb + b;
        block_dot(WQ.v[bi * 2u], WQ.v[bi * 2u + 1u], WS.v[bi], b - b0, count, acc);
    }
}

void main()
{
    const uint tid = gl_LocalInvocationID.x, lane = tid & 7u;
    uint mat = 0u, first = 0u, count = p.n;
    if (p.items != 0) {
        const ivec4 it = IV4(p.items).v[gl_WorkGroupID.y];
        mat = uint(it.x); first = uint(it.y); count = uint(it.z);
    }
    count = min(count, NV);
    const uint nb = p.cols / 64u;
    const uint64_t wbase = p.w + uint64_t(mat) * p.mat_bytes;
    UV4 WQ = UV4(wbase);
    U32 WS = U32(wbase + uint64_t(p.rows) * nb * 32u);
    const float gs = p.gscale != 0 ? F32(p.gscale).v[mat] : 1.0;
    const uint row = gl_WorkGroupID.x * 32u + (tid >> 3);
    const bool ok = row < (SITU != 0u ? p.ff : p.rows);
    float acc[NV], acc2[NV];
    [[unroll]] for (uint c = 0; c < NV; c++) { acc[c] = 0.0; acc2[c] = 0.0; }
    for (uint c0 = 0; c0 < nb; c0 += KB) {
        const uint cn = min(KB, nb - c0);
        if (c0 > 0u) barrier();
        for (uint i = tid; i < count * cn * 4u; i += 256u) {
            const uint c = i / (cn * 4u), r = i % (cn * 4u);
            const uint arow = p.cidx != 0 ? uint(I32(p.cidx).v[first + c]) : first + c;
            Aq[c * KB * 4u + r] = UV4(p.aq).v[arow * (p.aq_stride / 16u) + c0 * 4u + r];
        }
        for (uint i = tid; i < count * cn; i += 256u) {
            const uint c = i / cn, b = i % cn;
            const uint arow = p.cidx != 0 ? uint(I32(p.cidx).v[first + c]) : first + c;
            Ad[c * KB + b] = F32(p.ad).v[arow * p.ad_stride + c0 + b];
        }
        barrier();
        if (ok) {
            row_dot(WQ, WS, row, nb, c0, c0 + cn, lane, count, acc);
            if (SITU != 0u) row_dot(WQ, WS, p.ff + row, nb, c0, c0 + cn, lane, count, acc2);
        }
    }
    [[unroll]] for (uint c = 0; c < NV; c++) {
        acc[c] = subgroupClusteredAdd(acc[c], 8u);
        if (SITU != 0u) acc2[c] = subgroupClusteredAdd(acc2[c], 8u);
    }
    if (!ok || lane != 0u) return;
    F32 Y = F32(p.y);
    [[unroll]] for (uint c = 0; c < NV; c++) {
        if (c >= count) break;
        float v = acc[c] * gs;
        if (SITU != 0u) v = situ(v, acc2[c] * gs, p.beta, p.lbeta);
        else if (p.post == POST_SOFTCAP) v = p.cap * tanh_s(v / p.cap);
        Y.v[(first + c) * p.y_stride + row] = v;
    }
}
