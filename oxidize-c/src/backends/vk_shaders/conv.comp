#version 460
/* Causal 4-tap short convolution with residual, one thread per (token, ch).
 * Input j of this call is x[j] for j >= 0 and history row 3 + j for
 * j in [-3, -1]; the result goes to y (x is left intact), plus res when
 * res != 0 (res may alias y):
 *   y[t][c] = (h3 + sum_k wT[k][c] h_k + sum_l dyn[t][c/hs][l] h_{3-l}) * scale + res[t][c]
 * with h_k the input t + k - 3. With dn != 0 the input rows are the MoE
 * combine x[j][c] = sum_k wsel[j][k] * dn[pair_of[j][k]][c] instead of x.
 * Each thread also stores its own input in the history: row 3 + t for calls
 * of up to hmax tokens, else the last three inputs in rows 3..5. Both only
 * read history rows 0..2. */
#include "common.glsl"
layout(local_size_x = 256) in;
layout(push_constant) uniform P {
    uint64_t hist, x, y, wT, dyn, res, dn, wsel, pair_of;
    uint n, C, NC, off, n_heads, hs, K, hmax;
    float scale, pad;
} p;

float inp(uint j, uint c)
{
    if (p.dn == 0) return F32(p.x).v[j * p.C + c];
    float o = 0.0;
    for (uint k = 0; k < p.K; k++)
        o += F32(p.wsel).v[j * p.K + k] * F32(p.dn).v[uint(I32(p.pair_of).v[j * p.K + k]) * p.C + c];
    return o;
}

void main()
{
    const uint id = gl_GlobalInvocationID.x;
    if (id >= p.n * p.C) return;
    const uint t = id / p.C, c = id % p.C;
    F32 H = F32(p.hist);
    float h[4];
    [[unroll]] for (uint k = 0; k < 4u; k++) {
        const int j = int(t + k) - 3;
        h[k] = j >= 0 ? inp(uint(j), c) : H.v[uint(3 + j) * p.NC + p.off + c];
    }
    if (p.n <= p.hmax) H.v[(3u + t) * p.NC + p.off + c] = h[3];
    else if (t + 3u >= p.n) H.v[(t + 6u - p.n) * p.NC + p.off + c] = h[3];
    F32 W = F32(p.wT);
    float acc = W.v[c] * h[0];
    acc += W.v[p.C + c] * h[1];
    acc += W.v[2u * p.C + c] * h[2];
    acc += W.v[3u * p.C + c] * h[3];
    if (p.dyn != 0) {
        F32 D = F32(p.dyn);
        const uint tb = (t * p.n_heads + c / p.hs) * 4u;
        acc += D.v[tb] * h[3];
        acc += D.v[tb + 1u] * h[2];
        acc += D.v[tb + 2u] * h[1];
        acc += D.v[tb + 3u] * h[0];
    }
    float v = (h[3] + acc) * p.scale;
    if (p.res != 0) v += F32(p.res).v[id];
    F32(p.y).v[id] = v;
}
