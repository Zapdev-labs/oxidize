#version 450
/* UNVERIFIED — never compiled or run. Blind port of lk_silu_mul
 * (src/cuda/llama_cuda.cu). SwiGLU: gate = silu(gate) * up, silu = x*sigmoid(x).
 * Requires Vulkan SDK + GPU. */
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer GB { float g[]; } Gb;
layout(std430, binding = 1) readonly buffer UB { float u[]; } Ub;
layout(push_constant) uniform PC { int n; } pc;
void main() {
  int i = int(gl_GlobalInvocationID.x);
  if (i >= pc.n) return;
  float g = Gb.g[i];
  Gb.g[i] = (g / (1.0 + exp(-g))) * Ub.u[i];
}
