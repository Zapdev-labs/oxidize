+static void numa_build_cpu_map(const std::vector<NumaNode>& nodes) {
+  int maxcpu = 0;
+  for (auto& n : nodes) for (int c : n.cpus) maxcpu = std::max(maxcpu, c);
+  g_cpu_node.assign(static_cast<size_t>(maxcpu) + 1, 0);
+  for (auto& n : nodes)
+    for (int c : n.cpus) g_cpu_node[static_cast<size_t>(c)] = n.id;
