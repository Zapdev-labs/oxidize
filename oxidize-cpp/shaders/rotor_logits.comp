#version 450
// One thread per token: int4 dot product against the pre-rotated query.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer KeyCodes { uint key_codes[]; };
layout(std430, binding = 1) readonly buffer KeyScales { float key_scales[]; };
layout(std430, binding = 2) readonly buffer RotatedQuery { float rq[]; };
layout(std430, binding = 3) writeonly buffer Logits { float logits_out[]; };

layout(push_constant) uniform Push {
  uint n_tokens;
  uint head_dim;
  uint blocks;  // head_dim / block_size, block_size == 32
} pc;

void main() {
  const uint t = gl_GlobalInvocationID.x;
  if (t >= pc.n_tokens) {
    return;
  }
  // One nibble per dim; a token row is head_dim/8 words.
  const uint words_per_row = pc.head_dim / 8u;
  const uint row = t * words_per_row;
  float logit = 0.0;
  for (uint b = 0; b < pc.blocks; ++b) {
    float sum = 0.0;
    // 32 dims = 4 words per block.
    for (uint w = 0; w < 4u; ++w) {
      const uint word = key_codes[row + b * 4u + w];
      const uint dim = b * 32u + w * 8u;
      for (uint k = 0; k < 8u; ++k) {
        const float q = float((word >> (k * 4u)) & 15u) - 7.0;
        sum += rq[dim + k] * q;
      }
    }
    logit += sum * key_scales[t * pc.blocks + b];
  }
  logits_out[t] = logit;
}
