# Custom Prime Intellect template for Gemma 4 31B INT4 serving.
# Build: docker build --platform linux/amd64 -f Dockerfile.prime -t YOUR_USER/gemma4-31b-int4:v1 .
# Push and register as custom template on Prime Intellect.
FROM vllm/vllm-openai:gemma4-0505-cu129

RUN apt-get update && \
    apt-get install -y openssh-server nginx curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /var/run/sshd /root/.ssh && chmod 700 /root/.ssh && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config && \
    ssh-keygen -A

COPY launch.sh setup-node.sh nginx-dual.conf bench_tps.py /opt/gemma4/
RUN chmod +x /opt/gemma4/*.sh /opt/gemma4/bench_tps.py

ENV HF_HOME=/data/hf-cache
VOLUME ["/data/hf-cache"]

# Prime template startup script (set PUBLIC_KEY + SSH_PORT in template env):
#   /opt/gemma4/setup-node.sh && TIER=alpha /opt/gemma4/launch.sh && exec /usr/sbin/sshd -D
