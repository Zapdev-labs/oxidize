{
  "name": "oxidize-tui",
  "version": "0.1.0",
  "description": "Terminal console for the oxidize inference engine",
  "type": "module",
  "private": true,
  "main": "src/index.tsx",
  "bin": {
    "oxidize-tui": "src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun --hot run src/index.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --minify --target=bun src/index.tsx --outfile dist/oxidize-tui"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
