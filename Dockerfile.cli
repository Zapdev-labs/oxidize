FROM rust:1.95-bookworm AS builder
WORKDIR /workspace

COPY Cargo.toml Cargo.lock ./
COPY oxidize-rust/oxidize-core/Cargo.toml oxidize-rust/oxidize-core/Cargo.toml
COPY oxidize-rust/oxidize-core/build.rs oxidize-rust/oxidize-core/build.rs
COPY oxidize-rust/oxidize-server/Cargo.toml oxidize-rust/oxidize-server/Cargo.toml
COPY oxidize-rust/oxidize-cli/Cargo.toml oxidize-rust/oxidize-cli/Cargo.toml
COPY oxidize-rust/oxidize-quantize/Cargo.toml oxidize-rust/oxidize-quantize/Cargo.toml
COPY oxidize-rust/oxidize-py/Cargo.toml oxidize-rust/oxidize-py/Cargo.toml
COPY oxidize-rust/oxidize-train/Cargo.toml oxidize-rust/oxidize-train/Cargo.toml
COPY oxidize-rust/oxidize-finetuning/Cargo.toml oxidize-rust/oxidize-finetuning/Cargo.toml
COPY oxidize-rust/oxidize-convert/Cargo.toml oxidize-rust/oxidize-convert/Cargo.toml
COPY oxidize-rust/oxidize-ffi/Cargo.toml oxidize-rust/oxidize-ffi/Cargo.toml
COPY oxidize-rust/oxidize-kernels/Cargo.toml oxidize-rust/oxidize-kernels/Cargo.toml
COPY oxidize-rust/oxidize-prune/Cargo.toml oxidize-rust/oxidize-prune/Cargo.toml
COPY oxidize-rust/oxidize-merge/Cargo.toml oxidize-rust/oxidize-merge/Cargo.toml
COPY vendor/libp2p-dns vendor/libp2p-dns
COPY vendor/libp2p-mdns vendor/libp2p-mdns
COPY vendor/libp2p-yamux vendor/libp2p-yamux
COPY oxidize-rust/oxidize-core/src oxidize-rust/oxidize-core/src
COPY oxidize-rust/oxidize-core/benches oxidize-rust/oxidize-core/benches
COPY oxidize-rust/oxidize-core/kernels oxidize-rust/oxidize-core/kernels
COPY oxidize-rust/oxidize-server/src oxidize-rust/oxidize-server/src
COPY oxidize-rust/oxidize-cli/src oxidize-rust/oxidize-cli/src
COPY oxidize-rust/oxidize-quantize/src oxidize-rust/oxidize-quantize/src
COPY oxidize-rust/oxidize-py/src oxidize-rust/oxidize-py/src
COPY oxidize-rust/oxidize-train/src oxidize-rust/oxidize-train/src
COPY oxidize-rust/oxidize-finetuning/src oxidize-rust/oxidize-finetuning/src
COPY oxidize-rust/oxidize-convert/src oxidize-rust/oxidize-convert/src
COPY oxidize-rust/oxidize-ffi/src oxidize-rust/oxidize-ffi/src
COPY oxidize-rust/oxidize-kernels/src oxidize-rust/oxidize-kernels/src
COPY oxidize-rust/oxidize-kernels/benches oxidize-rust/oxidize-kernels/benches
COPY oxidize-rust/oxidize-prune/src oxidize-rust/oxidize-prune/src
COPY oxidize-rust/oxidize-merge/src oxidize-rust/oxidize-merge/src

RUN cargo build --release --package oxidize-cli

FROM debian:bookworm-slim
RUN useradd --create-home --shell /usr/sbin/nologin oxidize
WORKDIR /app
COPY --from=builder /workspace/target/release/oxidize-cli /usr/local/bin/oxidize-cli
USER oxidize
ENTRYPOINT ["/usr/local/bin/oxidize-cli"]
